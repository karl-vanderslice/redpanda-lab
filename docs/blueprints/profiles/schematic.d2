# Portable schematic visual defaults. Render with diagram-render SOURCE.d2 OUTPUT-STEM.
style.fill: "#faf8f2"
classes: {
  component: {
    style: {
      fill: "#faf8f2"
      stroke: "#292c30"
      font-color: "#292c30"
      stroke-width: 2
      font-size: 22
      border-radius: 0
      shadow: false
    }
  }
  relationship: {
    style: {
      stroke: "#292c30"
      font-color: "#292c30"
      stroke-width: 2
      font-size: 20
    }
  }

  accent: {style.stroke: "#526f83"}
  boundary: {style.stroke-dash: 4}
}

FROM registry-1.docker.io/library/node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS base

FROM base AS dependencies
# Build the bundled librdkafka from the integrity-locked npm tarball, not an unpinned prebuilt download.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ patch pkg-config libssl-dev libsasl2-dev zlib1g-dev libzstd-dev liblz4-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY app/package.json app/package-lock.json ./
COPY app/patches/librdkafka-coordinator-lifetime.patch /tmp/librdkafka-coordinator-lifetime.patch
RUN npm ci --registry=https://registry.npmjs.org/ --omit=dev --ignore-scripts --no-audit --no-fund \
    && patch --batch --fuzz=0 -d node_modules/@confluentinc/kafka-javascript/deps/librdkafka -p1 < /tmp/librdkafka-coordinator-lifetime.patch \
    && CKJS_LINKING=dynamic npm_config_build_from_source=true npm_config_nodedir=/usr/local npm rebuild @confluentinc/kafka-javascript --no-audit --no-fund \
    && npm cache clean --force

FROM base
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 libsasl2-2 zlib1g libzstd1 liblz4-1 libcurl4 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY app/package.json ./
COPY LICENSE /usr/share/licenses/redpanda-lab/LICENSE
COPY --chown=node:node app/server.js ./
COPY --chown=node:node app/public ./public
USER node
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "server.js"]

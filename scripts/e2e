#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ ${REDPANDA_LAB_SHELL:-0} != 1 ]]; then
  exec nix develop "path:$root" --no-update-lock-file -c bash "$root/scripts/e2e" "$@"
fi
name=${1:-explorer}
if [[ $name == explorer ]]; then exec bash "$root/tests/e2e.sh"; fi
case "$name" in trading|sports|agent-messaging|agent-chat|bitcoin|iot|pos|logistics|event-log|siem|activity|inventory|clearing|terraform|sovereignty) ;; *) echo 'Unknown lab.' >&2; exit 2 ;; esac
run_id="$(date +%Y%m%dT%H%M%S)-$$"
report_dir="${XDG_CACHE_HOME:-$HOME/.cache}/redpanda-lab/e2e/$name/$run_id"
mkdir -p "$report_dir"
touch "$report_dir/workflow.log" "$report_dir/runtime.log"
cd -- "$root"
shopt -s globstar nullglob dotglob
files=("$root/flake.nix" "$root/flake.lock" "$root/nix/podman-compose-lifecycle-status.patch" "$root/LICENSE" "$root/justfile" "$root/labs/run" "$root/scripts/local-podman" "$root/scripts/e2e" "$root/tests/http-routes.mjs")
for file in "$root/labs/common/"**/* "$root/labs/$name/"**/*; do [[ ! -f $file ]] || files+=("$file"); done
sha256sum "${files[@]}" > "$report_dir/source-sha256.txt"
finish() {
  status=$?
  trap - EXIT
  if [[ $name != terraform ]]; then
    "$root/labs/run" "$name" logs >> "$report_dir/runtime.log" 2>&1 || true
    if ! "$root/labs/run" "$name" down >> "$report_dir/runtime.log" 2>&1; then status=1; fi
  fi
  {
    printf '# %s E2E\n\n' "$name"
    printf -- "- Replay: \`nix develop --no-update-lock-file -c just test %s\`\n" "$name"
    if source_revision=$(git rev-parse HEAD 2>/dev/null); then
      printf -- '- Source revision: %s (source hashes below capture local changes)\n' "$source_revision"
    else
      printf -- '- Source revision: snapshot without Git metadata (source hashes below identify this run)\n'
    fi
    printf -- '- Exit status: %s\n' "$status"
    printf -- '- Tools: %s, %s, Node %s, %s\n' "$(podman --remote=false --version)" "$(nix --version)" "$(node --version)" "$(just --version)"
    printf -- "- Contract: \`labs/%s/e2e.sh\` and \`tests/http-routes.mjs\`. Observed output: [workflow.log](workflow.log).\n" "$name"
    printf -- '- Setup and cleanup: [runtime.log](runtime.log).\n\n'
    printf '## Source snapshot\n\n```text\n'
    cat "$report_dir/source-sha256.txt"
    printf '```\n'
  } > "$report_dir/report.md"
  echo "Report: $report_dir/report.md"
  exit "$status"
}
trap finish EXIT
if [[ $name == terraform ]]; then
  bash "$root/labs/terraform/lab" test 2>&1 | tee -a "$report_dir/workflow.log"
else
  # Public workflow oracles own a fresh disposable account, never an interactive ledger.
  "$root/labs/run" "$name" down >> "$report_dir/runtime.log" 2>&1
  "$root/labs/run" "$name" up >> "$report_dir/runtime.log" 2>&1
  node "$root/tests/http-routes.mjs" "$("$root/labs/run" "$name" urls --json | jq -er '.app')" "$name" 2>&1 | tee -a "$report_dir/workflow.log"
  bash "$root/labs/$name/e2e.sh" 2>&1 | tee -a "$report_dir/workflow.log"
fi

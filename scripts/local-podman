#!/usr/bin/env bash
# Sourced by engine consumers; engine-free commands never call this preflight.
require_local_podman() {
  if [[ ! -x ${REDPANDA_LAB_PODMAN:-} ]]; then
    printf 'Local Podman adapter is unavailable; enter the locked Nix development shell.\n' >&2
    return 1
  fi
  local host_info
  if ! host_info=$(podman --remote=false info --format json 9>&-); then
    printf 'Cannot inspect local Podman; no lab engine action was started.\n' >&2
    return 1
  fi
  if ! jq -e '.host.security.rootless == true' <<<"$host_info" >/dev/null; then
    printf 'This lab requires local rootless Podman; rootful engines are forbidden.\n' >&2
    return 1
  fi
}

# Bind an archive before touching shared cache tags owned by other checkouts.
load_archive_image() {
  local archive=$1 identity status=0
  identity=$(skopeo inspect --config --raw "docker-archive:$archive" | sha256sum) || return
  identity=${identity%% *}
  podman --remote=false image exists "$identity" 9>&- || status=$?
  case "$status" in
    0) ;;
    1)
      podman --remote=false load -i "$archive" 9>&- >&2 || return
      if ! podman --remote=false image exists "$identity" 9>&-; then
        printf 'Archive image was not loaded: %s\n' "$identity" >&2
        return 1
      fi
      ;;
    *) printf 'Cannot inspect archive image: %s\n' "$identity" >&2; return "$status" ;;
  esac
  printf '%s\n' "$identity"
}

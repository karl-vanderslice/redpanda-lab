#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ ${REDPANDA_LAB_SHELL:-0} != 1 ]]; then
  exec nix develop "path:$root" --no-update-lock-file -c bash "$root/scripts/check" "$@"
fi
cd -- "$root"
name=${1:-all}
case "$name" in all|explorer|trading|sports|agent-messaging|agent-chat|bitcoin|terraform|jurisdictions) ;; *) echo 'Unknown lab.' >&2; exit 2 ;; esac
just --list >/dev/null
shellcheck --severity=warning lab labs/run scripts/check scripts/docs scripts/dispatch scripts/e2e tests/e2e.sh
nixfmt --check flake.nix labs/*/*.nix
for file in labs/common/*.mjs; do node --check "$file"; done
node --check docs/assets/zensical-storage.js
if [[ $name == all || $name == explorer ]]; then
  node --check app/server.js
  node --check app/public/app.js
fi
for lab_name in trading sports agent-messaging agent-chat bitcoin terraform jurisdictions; do
  if [[ $name != all && $name != "$lab_name" ]]; then continue; fi
  if [[ $lab_name == terraform ]]; then
    bash labs/terraform/lab check
  elif [[ -f labs/$lab_name/lint.sh ]]; then
    bash "labs/$lab_name/lint.sh"
  else
    shellcheck "labs/$lab_name/e2e.sh"
    if [[ -f labs/$lab_name/lab ]]; then shellcheck "labs/$lab_name/lab"; fi
    for file in "labs/$lab_name/"*.mjs "labs/$lab_name/public/"*.js; do node --check "$file"; done
  fi
  system=$(nix eval --impure --raw --expr builtins.currentSystem)
  nix eval --no-update-lock-file --raw "path:$root#packages.$system.$lab_name-image.drvPath" >/dev/null
  echo "PASS $lab_name static and package evaluation gate"
done
bash scripts/docs build
